# ── Nuxt frontend ───────────────────────────────
# Copy to .env and fill in values

# Point to the local Laravel dev server
NUXT_PUBLIC_API_URL=http://localhost:8001/api/anime

# Optional external APIs
NUXT_PUBLIC_HIANIME_API=
NUXT_PUBLIC_TMDB_KEY=

# ── Laravel backend ─────────────────────────────
# Copy server/.env.example to server/.env, then:
#   npm run server:key      — generate APP_KEY
#   npm run server:migrate  — run database migrations
#
# Minimum vars to set in server/.env for local dev:
#   APP_KEY=          (auto-generated by server:key)
#   DB_CONNECTION=sqlite
#   FRONTEND_URL=http://localhost:3000
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#   TMDB_API_KEY=
